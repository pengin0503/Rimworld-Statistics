<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>StatisticsSdkSample</AssemblyName>
    <RequiredApiMinor Condition="'$(RequiredApiMinor)' == ''">0</RequiredApiMinor>
    <DefineConstants Condition="'$(RequiredApiMinor)' == '1'">$(DefineConstants);REQUIRES_API_MINOR_1</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)../../.devoutputs/sample/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/RimworldStatistics.Api/RimworldStatistics.Api.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetRefs)' == 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetRefs)' != 'true'">
    <Reference Include="Assembly-CSharp" HintPath="$(GameDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(GameDir)/UnityStubs.dll" Private="false" />
  </ItemGroup>
</Project>
