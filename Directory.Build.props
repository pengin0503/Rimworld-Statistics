<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory).refs/game</GameDir>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(MSBuildThisFileDirectory).refs/harmony/0Harmony.dll</HarmonyDll>
  </PropertyGroup>
</Project>
