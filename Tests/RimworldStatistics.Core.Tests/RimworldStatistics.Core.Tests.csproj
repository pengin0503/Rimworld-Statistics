<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>RimworldStatistics.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/RimworldStatistics.Core/RimworldStatistics.Core.csproj" />
  </ItemGroup>
  <!-- The game-independent part of the development-only verification harness (tools/VerifyHarness), tested here. -->
  <ItemGroup>
    <Compile Include="../../tools/VerifyHarness/Logic/*.cs" Link="VerifyHarnessLogic/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="RimworldStatistics.Core" />
    <Compile Include="../../Source/RimworldStatistics/IntegratedMods/*/Logic/*.cs" Link="IntegratedModLogic/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
